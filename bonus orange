			margin: 12px 0;

		}
		.card p {
			font-size: 14px;
			color: gray;
			margin-bottom: 15px;
		}
		button {
			padding: 12px 20px;
			background: #ff6600;
			border: none;
			border-radius: 8px;
			color: white;
			font-weight: bold;
			cursor: pointer;
		}
		button:hover{
			background: darkorange;
		}
		.card:hover{
			transform: translateY(-5px);

		}
		.phone-input{
			margin-top: 20px 0;
		}
		.phone-input input{
			padding: 12px;
			font-size: 16px;
			width: 280px;
			border-radius: 8px;
			border: 1px solid#ccc;
			text-align: center;
		}
		footer{
			margin-top: 40px;
			background: #ff6600;
			color: white;
			font-size: 22px;
			font-weight: bold;
			text-align: left;
			padding: 30px 10px;
			border-radius: 20px 20px 0 0;

		}
		@media(max-width: 768px){
			nav{
				display: none;
			}
			.card{
				width: 100%;
			}
		}
